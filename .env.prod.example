# Shedbooks production environment variables
# Copy to /opt/shedbooks/.env on the instance and fill in all values.
# This file must NOT be committed — .env is already in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=choose-a-strong-random-password

# ── Encryption ────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Used for encrypting stored secrets.
ENCRYPTION_KEY=choose-a-long-random-string-at-least-32-chars

# ── Auth0 ─────────────────────────────────────────────────────────────────────
AUTH0_DOMAIN=your-tenant.au.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
AUTH0_CLIENT_ID=your-spa-client-id

# ── Application ───────────────────────────────────────────────────────────────
CORS_ORIGIN=https://your-domain.com
ABR_GUID=

# ── OCIR Image References ─────────────────────────────────────────────────────
# Run: terraform output ocir_prefix  to get the base path
SHEDBOOKS_DB_IMAGE=region.ocir.io/namespace/shedbooks/db:latest
SHEDBOOKS_SERVER_IMAGE=region.ocir.io/namespace/shedbooks/server:latest
SHEDBOOKS_CLIENT_IMAGE=region.ocir.io/namespace/shedbooks/client:latest
