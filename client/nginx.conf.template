server {
    # TLS is terminated by the Azure Container Apps ingress (managed
    # certificate on the external FQDN / custom domain) — there is no
    # certificate bind mount available to a container app, and the
    # 80->443 redirect is likewise handled by the ingress, not here.
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the real client IP as seen by the Container Apps ingress
    # (a private-range hop in front of this container, same shape as the
    # old Docker port-mapping case this was originally written for).
    # nginx's real_ip module strips those addresses from X-Forwarded-For
    # and resets $remote_addr to the first public IP in the chain.
    set_real_ip_from  127.0.0.0/8;
    set_real_ip_from  10.0.0.0/8;
    set_real_ip_from  172.16.0.0/12;
    set_real_ip_from  192.168.0.0/16;
    real_ip_header    X-Forwarded-For;
    real_ip_recursive on;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json;
    gzip_min_length 1024;

    # RFC 6764 CardDAV service discovery — macOS/iOS start here when only the
    # hostname is provided (or when Manual mode strips the path).
    # Use a regex to catch both with and without trailing slash.
    # 308 preserves the HTTP method (PROPFIND) through the redirect.
    location ~ ^/.well-known/carddav/?$ {
        return 308 /api/carddav/principal;
    }

    location /api/ {
        # SERVER_INTERNAL_FQDN is the server container app's internal
        # ingress FQDN (<app-name>.internal.<environment-domain>) — not
        # known until the Container Apps Environment is provisioned, so
        # it's substituted from the container's environment at startup
        # (see /etc/nginx/templates/ in the Dockerfile) rather than
        # hardcoded here. The server app's ingress has
        # allow_insecure_connections enabled so plain http is fine for
        # this internal, VNet-scoped hop.
        proxy_pass         http://${SERVER_INTERNAL_FQDN}/;
        proxy_http_version 1.1;
        # Azure's internal Container Apps ingress routes by Host header —
        # forwarding the original public Host (shedbooks.<domain>, as the
        # old Docker Compose config did with $host) doesn't match any app
        # it knows about, so it falls back to its generic "Container App is
        # stopped or does not exist" page instead of reaching the server.
        # Must be the target app's own internal FQDN, not the client's.
        proxy_set_header   Host ${SERVER_INTERNAL_FQDN};
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
        # Raised from nginx's 60s default: POST /members/sync-o365 opens an
        # Exchange Online PowerShell session (module import + Connect-
        # ExchangeOnline can alone take 10-20s) before processing its batch
        # of members — see SyncMembersToO365UseCase.
        proxy_read_timeout 120s;
    }

    location / {
        # WebDAV methods must never receive the Flutter SPA — CoreDAV treats
        # HTML as a malformed XML response and fails with Code=6.
        if ($request_method ~ "^(PROPFIND|REPORT|PROPPATCH|MKCOL|COPY|MOVE|LOCK|UNLOCK)$") {
            return 404;
        }
        # Scoped to this location (and /index.html below) rather than the
        # server block, so they don't also land on /api/ responses — the
        # Dart backend already sets its own x-frame-options/x-content-type-
        # options/x-xss-protection there.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
        # Report-only draft: logs violations to the browser console instead
        # of blocking anything. Not verified against a real browser session —
        # load the app, check devtools for CSP warnings (Auth0 login flow
        # and Flutter's canvaskit/wasm rendering are the likely trip points),
        # and loosen/tighten before ever switching this to enforcing
        # (Content-Security-Policy, no "-Report-Only").
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.auth0.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://sharpblue.au.auth0.com; frame-src https://sharpblue.au.auth0.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
        try_files $uri $uri/ /index.html;
    }

    # Flutter's web build does not content-hash these top-level entrypoint
    # files (main.dart.js, the bootstrap loader, the service worker script,
    # version.json) — unlike this location's regex match below is applied
    # to numbered/hashed asset files. Serving them "immutable, max-age=1y"
    # means every browser that has ever loaded the app keeps running that
    # exact JS forever, silently ignoring every future deploy. `no-cache`
    # still lets nginx serve a 304 via ETag/Last-Modified when unchanged —
    # this only forces a revalidation round-trip, not a full re-download.
    location = /main.dart.js { add_header Cache-Control "no-cache, must-revalidate"; }
    location = /flutter.js { add_header Cache-Control "no-cache, must-revalidate"; }
    location = /flutter_bootstrap.js { add_header Cache-Control "no-cache, must-revalidate"; }
    location = /flutter_service_worker.js { add_header Cache-Control "no-cache, must-revalidate"; }
    location = /version.json { add_header Cache-Control "no-cache, must-revalidate"; }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|wasm|json)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://cdn.auth0.com 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://sharpblue.au.auth0.com; frame-src https://sharpblue.au.auth0.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;
    }
}
