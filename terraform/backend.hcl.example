# Backend config for the OCI Object Storage HTTP backend.
# Copy to backend.hcl and fill in the PAR URL. backend.hcl is gitignored.
# Generated automatically by scripts/bootstrap-state.sh.
#
# Usage: terraform init -backend-config=backend.hcl

address       = "https://objectstorage.ap-sydney-1.oraclecloud.com/p/<PAR-token>/n/<namespace>/b/shedbooks-tf-state/o/terraform.tfstate"
update_method = "PUT"
