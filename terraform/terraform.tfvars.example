# Copy to terraform.tfvars and fill in real values. terraform.tfvars is
# gitignored — never commit real secrets in it.
#
# Azure credentials are NOT set here — see variables.tf's Azure
# Authentication note (az login locally, azure/login + OIDC in CI).

location             = "australiaeast"
resource_group_name  = "rg-shedbooks-prod"

# Must match the ACR created by scripts/bootstrap-azure.sh
acr_resource_group_name = "rg-shedbooks-bootstrap"
acr_name                 = "acrshedbooks"

image_tag = "latest"

# PostgreSQL
postgres_admin_username = "shedbooks"
postgres_admin_password = "CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD"

# Entra ID login config is not set here — the "Shedbooks Login" App
# Registration (client_id, tenant_id) is created and managed entirely by
# entra_login.tf; no separate tfvars entry is needed.

# CORS_ORIGIN should match the client app's actual origin — after the first
# apply, set this to the client_fqdn output (or your bound custom domain).
cors_origin = "https://CHANGE_ME_YOUR_DOMAIN"

abr_guid = ""

encryption_key = "CHANGE_ME_USE_32_PLUS_RANDOM_CHARS"
